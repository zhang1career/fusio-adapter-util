{
  "name": "fusio/adapter-util",
  "description": "Provides several utility actions",
  "homepage": "https://www.fusio-project.org",
  "keywords": ["fusio-adapter"],
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Christoph Kappestein",
      "email": "christoph.kappestein@gmail.com",
      "homepage": "https://chrisk.app"
    }
  ],
  "require": {
    "php": ">=8.1",
    "fusio/engine": "^6.6.1",
    "psx/json": "^2.0|^3.0",
    "psx/sql": "^3.0|^4.0",
    "symfony/cache": "^6.0",
    "symfony/expression-language": "^6.0",
    "predis/predis": "^2.1",
    "twig/twig": "^3.0",
    "zhang1career/paganini": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "vimeo/psalm": "^5.9"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/zhang1career/fusio-engine.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/zhang1career/paganini.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "Fusio\\Adapter\\Util\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fusio\\Adapter\\Util\\Tests\\": "tests/"
    }
  }
}
